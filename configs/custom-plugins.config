# configs/custom-plugins.config
# ============================================================
# TurboACC 及相关包 — 由 CI 脚本在 make defconfig 之后追加注入
# 避免 Kconfig 循环依赖：
#   luci-app-turboacc ↔ kmod-nft-fullcone ↔ dnsmasq-full ↔ nftables-json
# ============================================================
CONFIG_PACKAGE_luci-app-turboacc=y
CONFIG_PACKAGE_luci-i18n-turboacc-zh-cn=y
CONFIG_PACKAGE_kmod-nft-fullcone=y
CONFIG_PACKAGE_dnsmasq-full=y
# 关闭硬件 offloading（BBR 软加速更稳定）
# CONFIG_PACKAGE_kmod-sfe is not set
# CONFIG_NF_FLOW_TABLE_HW is not set
CONFIG_TCP_CONG_BBR=y
CONFIG_DEFAULT_TCP_CONG_BBR=y

# nftables json 支持（TurboACC 依赖）
CONFIG_PACKAGE_libnftnl=y
CONFIG_PACKAGE_nftables=y
